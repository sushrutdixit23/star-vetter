# --- Pipeline working data: regenerated fresh by each run, never needs to
# persist between runs. What must persist (sample history, vetting result
# CSVs, catalogs, dossiers, the deployed site data) is NOT listed here. ---
/data/raw/
/data/lightcurves/
/data/pixel_check/
/data/logs/

